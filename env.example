# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get from: https://app.supabase.com/project/[your-project]/settings/api

# Project URL (format: https://[project-ref].supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
# Safe to expose in browser - has RLS restrictions
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
# ⚠️ SECRET - Never expose in browser! Bypasses RLS
# Required for admin tasks if implemented
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# OPENAI AI CONFIGURATION
# ============================================
# Get from: https://platform.openai.com/api-keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# ============================================
# GOOGLE SEARCH API CONFIGURATION
# ============================================
# Required for web search enrichment (content warnings from community sources)
# Get API Key: https://console.cloud.google.com/apis/credentials
# Get Search Engine ID: https://programmablesearchengine.google.com/
# Setup: Create a Custom Search Engine, enable "Search the entire web" option

# Google Custom Search API Key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key

# Google Custom Search Engine ID (CX)
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# ============================================
# OPTIONAL: SUPABASE LOCAL DEVELOPMENT
# ============================================
# Only needed if using SMS or Apple OAuth in local Supabase

# Twilio Auth Token (for SMS authentication)
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Apple OAuth Secret (for Apple Sign-In)
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=base64_encoded_secret
