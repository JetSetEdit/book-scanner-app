# dependencies
/node_modules

# Cursor / IDE
.cursor/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# AI Collaboration Status Files (keep in git for coordination)
# These files help coordinate work between AI assistants
# .antigravity-working.md
# .cursor-working.md

# Work-in-progress directories (exclude from git)
antigravity-wip/
cursor-wip/
node_modules
# Markdown
# We track docs and reports in this repo (design docs, testing reports, benchmark outputs, etc.).
# Only ignore explicitly-generated/local-only markdown if needed.
#
# If you want to keep a specific local-only markdown file out of git, add it here explicitly.
#
# Examples:
# .antigravity-working.md
# .cursor-working.md
#
# Re-include markdown generally.
!*.md
backups/
# Dataset downloads (can be large)
data/
!data/training/.gitkeep
!data/models/.gitkeepdatasets/

# macOS
.DS_Store
**/.DS_Store
